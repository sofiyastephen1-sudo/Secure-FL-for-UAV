# train.py
import torch
import torch.nn as nn
import torch.optim as optim
import numpy as np
import random

# ----------------------------
# Reproducibility (seeds)
# ----------------------------
def set_seed(seed=42):
    torch.manual_seed(seed)
    np.random.seed(seed)
    random.seed(seed)

set_seed(42)

# ----------------------------
# Simple CNN (lightweight UAV model)
# ----------------------------
class SimpleCNN(nn.Module):
    def __init__(self, num_classes=2):
        super(SimpleCNN, self).__init__()
        self.net = nn.Sequential(
            nn.Conv2d(3, 32, 3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(2),
            nn.Conv2d(32, 64, 3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(2),
            nn.AdaptiveAvgPool2d((1,1)),
        )
        self.fc = nn.Linear(64, num_classes)

    def forward(self, x):
        x = self.net(x)
        x = x.view(x.size(0), -1)
        return self.fc(x)

# ----------------------------
# Differential Privacy
# ----------------------------
def clip_gradients(model, max_norm=1.0):
    torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm)

def add_noise(model, sigma=1.1):
    for p in model.parameters():
        if p.grad is not None:
            noise = torch.normal(0, sigma, size=p.grad.shape).to(p.grad.device)
            p.grad += noise

# ----------------------------
# SCAFFOLD correction
# ----------------------------
def scaffold_update(model, global_c, local_c, lr):
    with torch.no_grad():
        for p, gc, lc in zip(model.parameters(), global_c, local_c):
            if p.grad is not None:
                p.grad = p.grad - lc + gc

# ----------------------------
# Local training (client)
# ----------------------------
def local_train(model, data_loader, global_c, local_c, epochs=1, lr=0.001):
    optimizer = optim.Adam(model.parameters(), lr=lr)
    criterion = nn.CrossEntropyLoss()

    for _ in range(epochs):
        for x, y in data_loader:
            optimizer.zero_grad()
            out = model(x)
            loss = criterion(out, y)
            loss.backward()

            # SCAFFOLD
            scaffold_update(model, global_c, local_c, lr)

            # DP
            clip_gradients(model, max_norm=1.0)
            add_noise(model, sigma=1.1)

            optimizer.step()

    return model

# ----------------------------
# Federated Averaging
# ----------------------------
def aggregate(models):
    global_model = models[0]
    state_dict = global_model.state_dict()

    for key in state_dict.keys():
        state_dict[key] = torch.stack(
            [m.state_dict()[key].float() for m in models], dim=0
        ).mean(dim=0)

    global_model.load_state_dict(state_dict)
    return global_model

# ----------------------------
# Simulated Federated Training
# ----------------------------
def federated_training(num_clients=10, rounds=5):
    global_model = SimpleCNN()

    # Initialize control variates (SCAFFOLD)
    global_c = [torch.zeros_like(p) for p in global_model.parameters()]

    for r in range(rounds):
        local_models = []

        for k in range(num_clients):
            local_model = SimpleCNN()
            local_model.load_state_dict(global_model.state_dict())

            local_c = [torch.zeros_like(p) for p in local_model.parameters()]

            # Dummy data (replace with real UAV dataset)
            x = torch.randn(16, 3, 224, 224)
            y = torch.randint(0, 2, (16,))
            loader = [(x, y)]

            trained_model = local_train(local_model, loader, global_c, local_c)
            local_models.append(trained_model)

        global_model = aggregate(local_models)
        print(f"Round {r+1} completed")

    return global_model

# ----------------------------
# Run
# ----------------------------
if __name__ == "__main__":
    federated_training()
